{
  "name": "@napolab/texture-bridge-renderer",
  "version": "0.15.0",
  "description": "High-level factory API for GPU texture bridge (BrowserWindow + Preview + Sender)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./client/worker-protocol": {
      "import": "./dist/client/worker-protocol.mjs",
      "require": "./dist/client/worker-protocol.cjs"
    },
    "./worker": {
      "import": "./dist/client/worker-protocol.mjs",
      "require": "./dist/client/worker-protocol.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/esm-shim-guard.mjs",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@napolab/texture-bridge-core": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "electron": ">=40.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naporin0624/electron-texture-bridge"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
