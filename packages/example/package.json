{
  "name": "@napolab/texture-bridge-example",
  "version": "0.1.0",
  "description": "Three.js raymarching VJ example with GPU texture bridge to Syphon",
  "author": "naporin0624",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:multiviewer": "cross-env MULTIVIEWER_ONLY=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p e2e/tsconfig.json",
    "e2e": "node e2e/run.mts"
  },
  "dependencies": {
    "@napolab/texture-bridge": "workspace:*",
    "@napolab/texture-bridge-renderer": "workspace:*",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.182.0",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
