{
  "name": "@napolab/texture-bridge-core",
  "version": "0.3.5",
  "description": "High-level GPU texture sharing for Electron (Spout + Syphon Metal)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --exports",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@napolab/texture-bridge": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=40.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naporin0624/electron-texture-bridge"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
